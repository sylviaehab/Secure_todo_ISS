# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection String
# Local: mongodb://localhost:27017/secure-todo-iss
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/secure-todo-iss
MONGODB_URI=mongodb://localhost:27017/secure-todo-iss

# JWT Secrets (Generate with: openssl rand -base64 64)
# CRITICAL: Change these in production!
JWT_SECRET=XqK9vR3mN8pL2wY5tH7jF4gD6sA1zX3cV8bN5mQ9wE2rT7yU4iO6pA3sD5fG8hJ2kL9xC4vB7nM1qW6eR3tY8uI5oP2aS7dF4gH9jK3lZ6xC1vB8nM5qW2eR9tY
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=YpL2wK6mR9vN3xQ8tH5jF7gD4sA2zX1cV6bN8mQ5wE3rT4yU9iO7pA2sD6fG5hJ3kL2xC7vB4nM9qW3eR6tY1uI8oP5aS2dF7gH4jK6lZ3xC8vB1nM2qW5eR4tY
JWT_REFRESH_EXPIRES_IN=30d

# AES-256 Encryption Key (MUST be exactly 32 bytes when base64 decoded)
# Generate with: openssl rand -base64 32
# CRITICAL: This key encrypts all todo content - keep it secret!
AES_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtc2VjdXJlLWFlcy0yNTYta2V5IQ==

# Google OAuth2 Credentials
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:4000

# Cookie Secret for signed cookies
COOKIE_SECRET=your-cookie-signing-secret-here
